# Copy this file to .env before running Docker Compose.
# Generate a JWT secret, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Intentionally blank: Docker Compose will refuse to start until both values
# are filled, so the example itself can never become an accepted credential.
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# Local HTTP demo uses false. Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
FORCE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Google mode is optional. Leave all four values empty to disable it. When
# enabled, the callback must also be registered as an authorized redirect URI
# in Google Cloud Console. Redirect URIs below are the exact values returned by
# browser.identity.getRedirectURL("google") for your published extension IDs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
OAUTH_EXTENSION_REDIRECT_URIS=

# Extension page origins allowed by CORS, e.g.
# chrome-extension://<chrome-id>,moz-extension://<firefox-runtime-uuid>
EXTENSION_ALLOWED_ORIGINS=
CANDIDATE_TOKEN_TTL_DAYS=90
